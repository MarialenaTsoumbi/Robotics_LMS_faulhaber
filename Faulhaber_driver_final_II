import os
import threading
import time
import tkinter as tk
from tkinter import messagebox, ttk

import canopen

# ---------------------------------------------------------------------------
# Settings - adjust to your setup
# ---------------------------------------------------------------------------
NODE_ID = 3                      # node ID set on the Faulhaber drive
EDS_FILENAME = '605.3150.69-C.eds'             # e.g. 'faulhaber.eds'; None = first *.eds found next to this script
CAN_INTERFACE = 'pcan'           # 'pcan', 'kvaser', 'vector', 'socketcan', ...
CAN_CHANNEL = 'PCAN_USBBUS1'     # e.g. 'can0' for socketcan
CAN_BITRATE = 250000

POS_MIN, POS_MAX = 0, 90000
VEL_MIN, VEL_MAX = 0, 900
MOVE_TIMEOUT = 60                # seconds to wait for "target reached"
GUI_TITLE = "Faulhaber Linear Motor Control"
MONITOR_INTERVAL = 0.1           # seconds between state readings
MAX_TABLE_ROWS = 1000            # oldest rows are dropped beyond this

BASE_DIR = os.path.dirname(os.path.abspath(__file__))

network = canopen.Network()
node = None

# Set by the Stop button; the running motor routine checks it and aborts
stop_event = threading.Event()


class StopRequested(Exception):
    """Raised inside a motor routine when the user pressed Stop."""


def check_stop():
    if stop_event.is_set():
        raise StopRequested()


def halt_motor():
    """Stop all motion immediately (works in velocity and position mode)."""
    try:
        node.sdo['Target Velocity'].raw = 0       # stops velocity mode
    except Exception:
        pass
    node.sdo['Controlword'].raw = 0x010F          # halt bit: decelerate to standstill, keep drive enabled


def add_sdo_lock(sdo):
    """Make every SDO read/write atomic, so the state monitor (own thread) and the
    motor routines (another thread) can share the CAN bus without mixing up replies."""
    lock = threading.RLock()
    for name in ('upload', 'download'):
        original = getattr(sdo, name)

        def wrapped(*args, _original=original, **kwargs):
            with lock:
                return _original(*args, **kwargs)

        setattr(sdo, name, wrapped)


def find_eds():
    if EDS_FILENAME:
        path = os.path.join(BASE_DIR, EDS_FILENAME)
        if not os.path.isfile(path):
            raise FileNotFoundError(f"EDS file not found: {path}")
        return path
    candidates = sorted(f for f in os.listdir(BASE_DIR) if f.lower().endswith('.eds'))
    if not candidates:
        raise FileNotFoundError(f"No .eds file found in {BASE_DIR}")
    return os.path.join(BASE_DIR, candidates[0])


# ---------------------------------------------------------------------------
# Motor functions
# ---------------------------------------------------------------------------
def start_func():
    node.nmt.state = 'OPERATIONAL'
    node.sdo['Controlword'].raw = 0x0006
    node.sdo['Controlword'].raw = 0x0007
    node.sdo['Controlword'].raw = 0x000F

    fw_version = node.sdo[0x100A].raw
    print(f"Current Firmware: {fw_version}")

    # initialize profile velocity mode
    node.sdo[0x6060].raw = 3

    I_current = node.sdo['Current Actual Value'].raw
    posi = node.sdo['Position Actual Value'].raw
    print(f"Initial Current value: {I_current}")

    # drive slowly towards the end stop until the current rises
    node.sdo['Target Velocity'].raw = -10
    t0 = time.time()
    while I_current < 200:
        check_stop()
        if time.time() - t0 > 30:
            node.sdo['Target Velocity'].raw = 0
            raise TimeoutError("End stop not found within 30 s")
        I_current = node.sdo['Current Actual Value'].raw

    posi = node.sdo['Position Actual Value'].raw
    print(f"pos: {posi}")
    node.sdo['Target Velocity'].raw = 0
    node.sdo['Controlword'].raw = 0x001F
    time.sleep(0.1)
    node.sdo[0x6060].raw = 1       # profile position mode
    node.sdo[0x607A].raw = 1000    # move away from the end stop
    node.sdo['Controlword'].raw = 0x000F
    node.sdo['Controlword'].raw = 0x007F
    print("stopped")
    posi = node.sdo['Position Actual Value'].raw
    print(f"pos: {posi}")

    time.sleep(0.1)

    vel = node.sdo['Velocity Actual Value'].raw
    print(f"Velocity: {vel}")

    I_current = node.sdo['Current Actual Value'].raw
    print(f"Current value: {I_current}")
    if I_current == 0:
        print("Zero Current")

    check_stop()

    # homing
    node.sdo[0x6060].raw = 6       # homing mode
    node.sdo[0x6098].raw = 35      # homing method 35
    node.sdo['Controlword'].raw = 0x000F
    node.sdo['Controlword'].raw = 0x001F
    posi = node.sdo['Position Actual Value'].raw
    print(f"pos: {posi}")


def endfunc():
    time.sleep(1)
    node.sdo['Controlword'].raw = 0x0006


def move_to(position, velocity):
    node.sdo[0x6060].raw = 1              # profile position mode
    node.sdo[0x6081].raw = velocity       # profile velocity
    node.sdo[0x607A].raw = position       # target position
    node.sdo['Controlword'].raw = 0x000F
    node.sdo['Controlword'].raw = 0x003F  # new set-point, absolute, start immediately

    t0 = time.time()
    while True:
        check_stop()
        sw = node.sdo[0x6041].raw
        if sw & 0x0400:                   # target reached
            break
        if time.time() - t0 > MOVE_TIMEOUT:
            raise TimeoutError("Target not reached in time")
        time.sleep(0.05)

    node.sdo['Controlword'].raw = 0x000F  # clear the new set-point bit
    return node.sdo['Position Actual Value'].raw


# ---------------------------------------------------------------------------
# GUI
# ---------------------------------------------------------------------------
class App:
    def __init__(self, root):
        self.root = root
        self.started = False
        self.busy = False

        root.title(GUI_TITLE)
        root.resizable(False, False)

        tk.Label(root, text=GUI_TITLE, font=("Segoe UI", 16, "bold")).pack(padx=20, pady=(15, 10))

        # Start / End buttons directly under the title
        btn_frame = tk.Frame(root)
        btn_frame.pack(pady=5)
        self.start_btn = tk.Button(btn_frame, text="Start", width=12, command=self.on_start)
        self.start_btn.grid(row=0, column=0, padx=5)
        self.end_btn = tk.Button(btn_frame, text="End", width=12, command=self.on_end)
        self.end_btn.grid(row=0, column=1, padx=5)
        self.stop_btn = tk.Button(btn_frame, text="STOP", width=12, bg="#c62828", fg="white",
                                  activebackground="#8e0000", activeforeground="white",
                                  command=self.on_stop)
        self.stop_btn.grid(row=0, column=2, padx=5)

        # Position / velocity inputs
        form = tk.Frame(root)
        form.pack(padx=20, pady=10)
        tk.Label(form, text=f"Target position ({POS_MIN}-{POS_MAX}):").grid(row=0, column=0, sticky="e", pady=3)
        self.pos_entry = tk.Entry(form, width=12)
        self.pos_entry.grid(row=0, column=1, padx=5)
        tk.Label(form, text=f"Velocity ({VEL_MIN}-{VEL_MAX}):").grid(row=1, column=0, sticky="e", pady=3)
        self.vel_entry = tk.Entry(form, width=12)
        self.vel_entry.grid(row=1, column=1, padx=5)

        self.move_btn = tk.Button(root, text="Move", width=26, command=self.on_move)
        self.move_btn.pack(pady=5)

        self.status = tk.StringVar(value="Connecting...")
        tk.Label(root, textvariable=self.status, fg="gray25", wraplength=320).pack(padx=20, pady=(10, 15))

        # Live motor state table (a new row is added whenever a value changes)
        state_frame = tk.LabelFrame(root, text="Motor state", padx=8, pady=6)
        state_frame.pack(fill="both", expand=True, padx=20, pady=(0, 15))

        columns = ("time", "position", "velocity", "current")
        headings = ("Time", "Absolute position", "Velocity", "Current")
        self.table = ttk.Treeview(state_frame, columns=columns, show="headings", height=8)
        for col, head in zip(columns, headings):
            self.table.heading(col, text=head)
            self.table.column(col, width=100 if col == "time" else 120, anchor="center")
        scroll = ttk.Scrollbar(state_frame, orient="vertical", command=self.table.yview)
        self.table.configure(yscrollcommand=scroll.set)
        self.table.grid(row=0, column=0, sticky="nsew")
        scroll.grid(row=0, column=1, sticky="ns")
        tk.Button(state_frame, text="Clear table",
                  command=lambda: self.table.delete(*self.table.get_children())
                  ).grid(row=1, column=0, sticky="e", pady=(6, 0))
        state_frame.columnconfigure(0, weight=1)

        self.monitor_stop = threading.Event()
        self.monitor_thread = None

        self.update_buttons()
        root.protocol("WM_DELETE_WINDOW", self.on_close)
        self.connect()

    # -- helpers ----------------------------------------------------------
    def set_status(self, text):
        self.root.after(0, lambda: self.status.set(text))

    def update_buttons(self):
        connected = node is not None
        self.start_btn.config(state="normal" if connected and not self.started and not self.busy else "disabled")
        self.end_btn.config(state="normal" if connected and self.started and not self.busy else "disabled")
        self.move_btn.config(state="normal" if connected and self.started and not self.busy else "disabled")
        # Stop is available at any time, whether the motor is moving or not
        self.stop_btn.config(state="normal" if connected else "disabled")

    def run_in_thread(self, work, on_success=None):
        """Run a blocking motor call off the GUI thread so the window stays responsive."""
        self.busy = True
        stop_event.clear()
        self.update_buttons()

        def target():
            try:
                result = work()
                self.root.after(0, lambda: self.finish(None, on_success, result))
            except StopRequested:
                # the stop is carried out here, in the thread that owns the CAN/SDO traffic
                try:
                    halt_motor()
                    err = None
                except Exception as e:
                    err = e
                self.root.after(0, lambda: self.finish_stopped(err))
            except Exception as e:
                self.root.after(0, lambda err=e: self.finish(err, None, None))

        threading.Thread(target=target, daemon=True).start()

    def finish(self, error, on_success, result):
        self.busy = False
        if error is not None:
            self.status.set(f"Error: {error}")
        elif on_success:
            on_success(result)
        self.update_buttons()

    def finish_stopped(self, error):
        self.busy = False
        if error is not None:
            self.status.set(f"Stop failed: {error}")
        else:
            self.status.set("Motor stopped by user.")
        self.update_buttons()

    # -- actions ----------------------------------------------------------
    def connect(self):
        global node
        try:
            eds_path = find_eds()
            network.connect(interface=CAN_INTERFACE, channel=CAN_CHANNEL, bitrate=CAN_BITRATE)
            node = network.add_node(NODE_ID, eds_path)
            add_sdo_lock(node.sdo)
            self.start_monitor()
            self.status.set(f"Connected (node {NODE_ID}, EDS: {os.path.basename(eds_path)}). Press Start.")
        except Exception as e:
            self.status.set(f"Connection failed: {e}")
        self.update_buttons()

    # -- state monitor ----------------------------------------------------
    def start_monitor(self):
        self.monitor_stop.clear()
        self.monitor_thread = threading.Thread(target=self.monitor_loop, daemon=True)
        self.monitor_thread.start()

    def monitor_loop(self):
        last = None
        while not self.monitor_stop.is_set():
            try:
                values = (
                    node.sdo['Position Actual Value'].raw,
                    node.sdo['Velocity Actual Value'].raw,
                    node.sdo['Current Actual Value'].raw,
                )
            except Exception:
                values = None          # drive busy / not ready: just try again

            if values is not None and values != last:
                last = values
                now = time.time()
                stamp = time.strftime('%H:%M:%S', time.localtime(now)) + f".{int(now * 1000) % 1000:03d}"
                try:
                    self.root.after(0, lambda v=values, s=stamp: self.add_row(s, v))
                except RuntimeError:
                    return             # window already closed
            self.monitor_stop.wait(MONITOR_INTERVAL)

    def add_row(self, stamp, values):
        self.table.insert("", "end", values=(stamp, *values))
        children = self.table.get_children()
        if len(children) > MAX_TABLE_ROWS:
            self.table.delete(*children[:len(children) - MAX_TABLE_ROWS])
        self.table.see(self.table.get_children()[-1])

    def on_start(self):
        self.status.set("Starting (searching end stop, homing)...")

        def done(_):
            self.started = True
            self.status.set("Started. Enter position and velocity, then press Move.")

        self.run_in_thread(start_func, done)

    def on_end(self):
        self.status.set("Stopping...")

        def done(_):
            self.started = False
            self.status.set("Motor stopped (shutdown).")

        self.run_in_thread(endfunc, done)

    def on_stop(self):
        if self.busy:
            # a routine is running: ask it to abort and halt the motor
            stop_event.set()
            self.status.set("Stopping...")
        else:
            # idle: send the halt directly
            self.status.set("Stopping...")
            self.run_in_thread(halt_motor, lambda _: self.status.set("Motor stopped by user."))

    def on_move(self):
        try:
            pos = int(self.pos_entry.get())
            vel = int(self.vel_entry.get())
        except ValueError:
            messagebox.showerror("Invalid input", "Position and velocity must be integers.")
            return
        if not POS_MIN <= pos <= POS_MAX:
            messagebox.showerror("Invalid position", f"Position must be between {POS_MIN} and {POS_MAX}.")
            return
        if not VEL_MIN <= vel <= VEL_MAX:
            messagebox.showerror("Invalid velocity", f"Velocity must be between {VEL_MIN} and {VEL_MAX}.")
            return
        if vel == 0:
            messagebox.showerror("Invalid velocity", "Velocity 0 means the motor will not move. Use a value above 0.")
            return

        self.status.set(f"Moving to {pos} at velocity {vel}...")
        self.run_in_thread(
            lambda: move_to(pos, vel),
            lambda actual: self.status.set(f"Target reached. Actual position: {actual}"),
        )

    def on_close(self):
        if self.busy:
            if not messagebox.askyesno("Busy", "The motor is still working. Close anyway?"):
                return
        self.monitor_stop.set()
        if self.monitor_thread is not None:
            self.monitor_thread.join(timeout=1)
        try:
            if self.started and node is not None:
                node.sdo['Controlword'].raw = 0x0006   # shut the drive down
        except Exception:
            pass
        try:
            network.disconnect()
        except Exception:
            pass
        self.root.destroy()


if __name__ == '__main__':
    root = tk.Tk()
    App(root)
    root.mainloop()